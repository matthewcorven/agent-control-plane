<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- The interactive client components live in AGUIWebChat.Client.Wasm (Blazor WebAssembly,
         Interactive Auto render mode); this host runs the server-side shell and the
         server-rendered phase of the Auto lifecycle. -->
    <!-- Must match the net11.0 target: the package only ships net11.0 assets, so a
         mismatched TFM contributes no extension methods and the host fails to compile. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Logs\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts and Middleware flow transitively through the WebAssembly project. -->
    <ProjectReference Include="..\Client.Wasm\AGUIWebChat.Client.Wasm.csproj" />
    <ProjectReference Include="..\ServiceDefaults\AGUIWebChat.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
