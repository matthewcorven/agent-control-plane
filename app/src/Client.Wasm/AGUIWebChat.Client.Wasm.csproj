<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep component namespaces identical to the pre-split AGUIWebChat.Client project
         (AGUIWebChat.Client.Components.*, ...Services.*, ...Models.*) so existing
         @using directives, tests, and generated code resolve unchanged. -->
    <RootNamespace>AGUIWebChat.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- AGUI.Client brings the AGUIChatClient transport; AGUI.Abstractions supplies the protocol
         event types the chat page binds directly (RunStartedEvent, ReasoningMessageContentEvent). -->
    <PackageReference Include="AGUI.Abstractions" Version="1.0.0" />
    <PackageReference Include="AGUI.Client" Version="1.0.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Markdown.ColorCode" Version="3.0.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.23.0" />
    <!-- Spike (#3): Blazor AI component model (UIAgent/ChatPage/BlockRenderer). Prerelease only. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.AI" Version="11.0.0-preview.7.26425.128" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- AddHttpClient / typed clients + DelegatingHandler pipelines are not part of the
         Blazor WebAssembly shared framework and must be referenced explicitly. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Validation" Version="11.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\AGUIWebChat.Contracts.csproj" />
    <ProjectReference Include="..\Middleware\AGUIWebChat.Middleware.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AGUIWebChat.Client.Tests" />
  </ItemGroup>

</Project>
