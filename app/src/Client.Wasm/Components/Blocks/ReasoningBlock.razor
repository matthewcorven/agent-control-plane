@using AGUIWebChat.Client.Models

@* Collapsible reasoning panel with duration/chunk stats, replacing the plain ChatReasoning dump. *@

@if (DisplayMode != ReasoningDisplayMode.Hidden && !string.IsNullOrWhiteSpace(Block.Text))
{
    <FluentCard Class="reasoning-block">
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(Expanded ? new Icons.Regular.Size16.ChevronUp() : new Icons.Regular.Size16.ChevronDown())"
                      OnClick="Toggle"
                      aria-expanded="@Expanded"
                      aria-label="Toggle reasoning">
            Reasoning
            @if (Block.DurationMs.HasValue)
            {
                <span class="reasoning-block-duration">· @FormatDuration(Block.DurationMs.Value)</span>
            }
        </FluentButton>

        @if (Expanded)
        {
            <div class="reasoning-block-content">@Block.Text</div>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="reasoning-block-stats">
                @if (Block.ChunkCount.HasValue)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint">@Block.ChunkCount chunks</FluentBadge>
                }
                @if (Block.CharacterCount.HasValue)
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint">@Block.CharacterCount chars</FluentBadge>
                }
            </FluentStack>
        }
    </FluentCard>
}

@code {
    [Parameter, EditorRequired]
    public required ChatBlockModel Block { get; set; }

    [Parameter]
    public ReasoningDisplayMode DisplayMode { get; set; }

    private bool Expanded;
    private ReasoningDisplayMode? PreviousDisplayMode;

    protected override void OnParametersSet()
    {
        if (PreviousDisplayMode != DisplayMode)
        {
            Expanded = DisplayMode == ReasoningDisplayMode.Expanded;
            PreviousDisplayMode = DisplayMode;
        }
    }

    private void Toggle() => Expanded = !Expanded;

    private static string FormatDuration(double durationMs) =>
        durationMs < 1000 ? $"{durationMs:F0} ms" : $"{durationMs / 1000:F1} s";
}
