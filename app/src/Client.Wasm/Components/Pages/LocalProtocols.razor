@page "/local-protocols"
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

<h1>Local protocol demonstrations</h1>
<p>Actual A2A HTTP+JSON discovery and calls run against a short-lived loopback-only deterministic echo agent. This is not model inference. Streaming events are displayed together after the stream completes; background tasks are polled during the request.</p>
<label for="protocol-message">Message to the echo agent</label>
<input id="protocol-message" @bind="_message" maxlength="1000" />
<button disabled="@_busy" @onclick='() => RunAsync("stream")'>Run A2A stream</button>
<button disabled="@_busy" @onclick='() => RunAsync("background")'>Run A2A background task</button>
<h2>MCP arithmetic</h2>
<p>Uses a real local MCP client/server over in-process streams; no model chooses the tool.</p>
<label for="protocol-left">Left</label><input id="protocol-left" type="number" @bind="_left" />
<label for="protocol-right">Right</label><input id="protocol-right" type="number" @bind="_right" />
<button disabled="@_busy" @onclick='() => RunAsync("mcp")'>Discover and call MCP tool</button>
<pre role="status" style="white-space:pre-wrap">@_output</pre>

@code {
    private string _message = "Hello from the app";
    private int _left = 19, _right = 23;
    private bool _busy;
    private string _output = "";
    private IJSObjectReference? _module;
    private async Task RunAsync(string mode)
    {
        _busy = true; _output = "Running…";
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./local-protocol-workflow.mjs");
            var backend = Configuration["AGUI_SERVER_URL"] ?? "http://localhost:5100";
            var events = await _module.InvokeAsync<string[]>("run", backend, mode, _message, _left, _right);
            _output = string.Join("\n", events);
        }
        catch { _output = "Protocol request failed. Check local server, origin configuration, and browser CORS."; }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
